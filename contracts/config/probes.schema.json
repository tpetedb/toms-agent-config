{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ProbeSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "expect_exit": {
          "default": 0,
          "title": "Expect Exit",
          "type": "integer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "version",
                "trust"
              ],
              "type": "string"
            },
            {
              "enum": [
                "spawn-missing-token",
                "spawn-altered-token",
                "spawn-reused-token",
                "spawn-tool-absent",
                "runner-lost",
                "hook-timeout",
                "keychain-token-denied",
                "keychain-key-denied",
                "ruleset-owner-review",
                "push-required-checks",
                "classifier-script-computed"
              ],
              "type": "string"
            }
          ],
          "title": "Kind"
        }
      },
      "required": [
        "description",
        "kind"
      ],
      "title": "ProbeSpec",
      "type": "object"
    }
  },
  "properties": {
    "probes": {
      "additionalProperties": {
        "$ref": "#/definitions/ProbeSpec"
      },
      "title": "Probes",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "probes"
  ],
  "title": "ProbesFile",
  "type": "object"
}
