%% Pipeline board: the board decides a question that loosens policy or touches the checker.
%% Drawn from .agents/config/pipelines/board.toml.
%% Legend: green terminator, blue process, yellow decision, orange input or output, red stop.
flowchart TD
    Q[/"board-question"/] --> DE["design: the lead director<br/>writes position"]
    DE --> RV["review: every other director, independently<br/>writes critique"]
    RV --> RE["revise: the lead director<br/>writes position"]
    RE --> DC{"decide: just board-tally<br/>waits on M8"}
    DC -->|fail| H[/"to the owner"/]
    DC -->|pass| PR["propose: chief<br/>writes proposal"]
    PR --> RU[/"rule: the owner<br/>approve or loosen policy"/]
    RU --> Z(["decided"])
    classDef term fill:#00A86B,stroke:#00D084,color:#000000
    classDef proc fill:#0067A5,stroke:#0088CC,color:#FFFFFF
    classDef dec fill:#FFBF00,stroke:#FFD500,color:#000000
    classDef io fill:#FF8C1A,stroke:#FFA94D,color:#000000
    classDef store fill:#9A2A2A,stroke:#F04923,color:#FFFFFF
    classDef stop fill:#D32F2F,stroke:#F04923,color:#FFFFFF
    class Z term
    class DE,RV,RE,PR proc
    class DC dec
    class Q,RU io
    class H stop
