%% Pipeline retro: lessons extracted from a landed order, reviewed before promotion.
%% Drawn from .agents/config/pipelines/retro.toml.
%% Legend: green terminator, blue process, orange input or output.
flowchart TD
    IN[/"build-report and review"/] --> EX["extract: chief<br/>writes lessons"]
    EX --> PR[/"promote: the owner approves<br/>the lessons worth keeping"/]
    PR --> Z(["kept lessons reach memory"])
    classDef term fill:#00A86B,stroke:#00D084,color:#000000
    classDef proc fill:#0067A5,stroke:#0088CC,color:#FFFFFF
    classDef dec fill:#FFBF00,stroke:#FFD500,color:#000000
    classDef io fill:#FF8C1A,stroke:#FFA94D,color:#000000
    classDef store fill:#9A2A2A,stroke:#F04923,color:#FFFFFF
    classDef stop fill:#D32F2F,stroke:#F04923,color:#FFFFFF
    class Z term
    class EX proc
    class IN,PR io
